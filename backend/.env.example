PORT=5000
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=replace_with_a_long_random_secret
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
# Set to true only after adding Razorpay test/live credentials below.
PAYMENT_GATEWAY_ENABLED=true
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret
# Amount is in paise: 19900 = ₹199.00
RAZORPAY_PREMIUM_AMOUNT_PAISE=19900
RAZORPAY_CURRENCY=INR
# Local: http://localhost:5173. Production: https://ai-notes-summarizer-app-one.vercel.app
CLIENT_URL=http://localhost:5173
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="AI Notes Summarizer <no-reply@example.com>"
